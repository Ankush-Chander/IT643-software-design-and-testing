+// Sprout class: pause state, independent of terminal I/O so it can be unit tested.
+class PauseController {
+    bool paused = false;
+public:
+    static bool isPauseKey(char k) { return k == 'p' || k == 'P'; }
+    // Returns true if the key was a pause key (and toggles the state).
+    bool handleKey(char k) {
+        if (!isPauseKey(k)) return false;
+        paused = !paused;
+        return true;
+    }
+    bool isPaused() const { return paused; }
+    void reset() { paused = false; }
+};
